# Gemini API (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Host login
HOST_USERNAME=host
HOST_PASSWORD=change_me

PORT=3000

# Optional tuning
# EVENT_MINUTES=45
# RELEASE_SECONDS=60
# MOCK_AI=1   (fake AI output for testing without a key)

# Event settings (defaults shown)
# PARTICIPANT_COUNT=70     accounts pa001..pa070 are created on first start
# PROMPT_MIN=1             minimum non-empty prompt length
# PROMPT_MAX=2000          maximum prompt length
# QUIZ_SECONDS=60          time limit per quiz attempt (2 attempts per round)
# QUIZ_PASS=5              correct answers needed (default = all QUIZ_QUESTIONS) to unlock the reward prompt
# QUIZ_QUESTIONS=5         questions per attempt

# Real email sending for participant websites (pick ONE; without it forms say they could not send)
# RESEND_API_KEY=re_xxx          (HTTPS API - works on Render)
# SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=app_password
# MAIL_FROM=you@yourdomain.com   MAIL_NOTIFY=host@yourdomain.com (optional copy of every submission)
